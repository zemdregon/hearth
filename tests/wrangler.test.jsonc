{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hearth-family-e2e",
  "main": "../src/server/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "hearth-family-e2e", "database_id": "11111111-1111-1111-1111-111111111111", "migrations_dir": "../migrations" }],
  "vars": {
    "WEBAUTHN_RP_ID": "localhost",
    "APP_ORIGIN": "http://localhost:5173",
    "FAMILY_TIMEZONE": "UTC",
    "FAMILY_QUESTION_PAIR": "[\"alex\",\"sam\"]"
  },
  "workers_dev": false
}
