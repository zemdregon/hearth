{
  "name": "hearth-family",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "node scripts/dev.mjs",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787 --local-upstream localhost:5173 --upstream-protocol http",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "auth:roster:check": "node scripts/check-auth-roster.mjs",
    "auth:operator": "node scripts/auth-operator.mjs",
    "test:restore": "node scripts/rehearse-restore.mjs",
    "test:inventory:d1": "node scripts/probe-inventory-d1.mjs",
    "test:inventory:api:d1": "node scripts/probe-inventory-api-d1.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm test && npm run build",
    "deploy:preflight": "node scripts/preflight.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
