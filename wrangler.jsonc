{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearth-family",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "hearth-family-db", "database_id": "f7dbb33a-1e98-4716-b59f-ad3ed1bf2728", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI" },
  "vars": { "FAMILY_TIMEZONE": "UTC" },
  "observability": { "enabled": false },
  "workers_dev": false,
  "routes": [{ "pattern": "hearth.kaina.one", "custom_domain": true }]
}
