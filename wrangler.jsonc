{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearth-family",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "hearth-family", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI" },
  "vars": { "FAMILY_TIMEZONE": "UTC" },
  "observability": { "enabled": false },
  "workers_dev": false
}
